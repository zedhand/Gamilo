<?xml version="1.0" encoding="utf-8"?>
<!--
    Gamilo intentionally disables Android Auto Backup (android:allowBackup="false" in the
    manifest) because the Room database is encrypted at rest and backups are handled by the
    app's own WorkManager job + Storage Access Framework export, not the OS backup service.
    This file is kept only because fullBackupContent is a required attribute reference.
-->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
</full-backup-content>
